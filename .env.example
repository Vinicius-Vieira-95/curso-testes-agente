# 1) Copie este arquivo:  cp .env.example .env   (Windows: copy .env.example .env)
# 2) Cole sua chave do Google AI Studio abaixo (https://aistudio.google.com/apikey)
# 3) NUNCA faça commit do arquivo .env — ele já está no .gitignore

GOOGLE_API_KEY=cole-sua-chave-aqui

# Modelo que responde como "agente" (barato e rápido)
MODELO_AGENTE=gemini-3.5-flash-lite
# Modelo que atua como "juiz" nas métricas do DeepEval (LLM-as-a-judge)
MODELO_JUIZ=gemini-3.5-flash

# Resiliência contra erro 429 (usado em src/agente/resiliencia.py)
MAX_TENTATIVAS=5
REQUISICOES_POR_MINUTO=10

# DeepEval: não enviar telemetria / não pedir login no Confident AI
DEEPEVAL_TELEMETRY_OPT_OUT=YES
# Retry interno do DeepEval para o juiz (padrão é só 2 tentativas com teto de 5s — pouco para o free tier)
DEEPEVAL_RETRY_MAX_ATTEMPTS=5
DEEPEVAL_RETRY_CAP_SECONDS=60
